# =====================
# Python 3.9.16 core image
# ---------------------

FROM python:3.9.16

# Pass in user/group info as build args
ARG USER_ID=1000
ARG GROUP_ID=1000

# =====================
# Basic enviroment setup
# ---------------------

# Set default environment
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    apt-utils \
    curl \
    locales \
    nano \
    ssh \
    sudo \
    bash \
    git \
    make \
    gcc \
    # Adding Slurm dependencies
    munge \
    libmunge-dev \
    libslurm-dev \
 && rm -rf /var/lib/apt/lists/*

# =====================
# Slurm compatibility setup
# ---------------------
# Set environment variables for Slurm
ENV SLURM_CONF=/etc/slurm/slurm.conf
ENV PATH=$PATH:/usr/local/bin:/usr/bin:/bin

# Create directories needed for Slurm logs and state
RUN mkdir -p /var/spool/slurmd \
    && mkdir -p /var/log/slurm \
    && mkdir -p /var/run/slurm

# =====================
# User stuff
# ---------------------

# https://wiki.debian.org/Locale#Manually
RUN sed -i "s/# en_US.UTF-8/en_US.UTF-8/" /etc/locale.gen \
  && locale-gen
ENV LANG=en_US.UTF-8
ENV SHELL=/bin/bash

# Create user with the provided USER_ID/GROUP_ID (or default to 1000)
RUN groupadd -g $GROUP_ID usergroup || groupmod -g $GROUP_ID usergroup || true \
    && useradd -m -u $USER_ID -g $GROUP_ID coder || usermod -u $USER_ID -g $GROUP_ID coder \
    && echo "coder:admin-coder" | chpasswd \
    && usermod -s /bin/bash coder

# ==========================================
# Project-specific installation instruction
# ------------------------------------------

COPY bash.bashrc /etc
RUN sed -i 's/\r$//' /etc/bash.bashrc && chmod +x /etc/bash.bashrc

ENV BUILD_ENVIRONMENT="development"
ENV XDG_CACHE_HOME="/opt/dev/cache"
WORKDIR /home/coder/autogoal

# Make RUN commands use the autogoal environment
COPY makefile /home/coder/autogoal/

# Setup poetry configuration
RUN pip install -U pip setuptools
RUN pip install poetry==1.8.4
RUN poetry config virtualenvs.create false

SHELL ["/bin/bash", "-c"]
RUN mkdir -p /home/coder/autogoal/data && rm -rf /home/coder/autogoal/storage && mkdir -p /home/coder/autogoal/storage && chown -R coder:usergroup /home/coder/autogoal

# Set permissions for important directories
RUN mkdir -p /opt/dev/cache && chown -R coder:usergroup /home/coder /opt/dev/cache

# Copy code-base for autogoal-core
COPY autogoal/ /home/coder/autogoal/autogoal

# Copy code-base for autogoal-contrib
COPY autogoal-contrib/ /home/coder/autogoal/autogoal-contrib

# Copy code-base for autogoal-remote
COPY autogoal-remote/ /home/coder/autogoal/autogoal-remote

# Copy code-base for autogoal-remote
COPY scripts/ /home/coder/autogoal/scripts

# Install autogoal core
COPY dockerfiles/install-package.sh /home/coder/autogoal/install-package.sh 

# Fix line endings
RUN find /home/coder/autogoal -type f \
    -exec sed -i 's/\r$//' {} \; || true

RUN chmod +x install-package.sh && ./install-package.sh core contrib sklearn nltk transformers telegram

# Allow 'coder' to use sudo without a password
RUN echo "coder ALL=(ALL) NOPASSWD:ALL" | sudo tee /etc/sudoers.d/coder && sudo chmod 0440 /etc/sudoers.d/coder

# =====================
# GPU and Slurm compatibility
# ---------------------
# Create a script to check for GPU availability
RUN echo '#!/bin/bash\nif [ -x "$(command -v nvidia-smi)" ]; then\n  nvidia-smi\nelse\n  echo "No GPU found"\nfi' > /usr/local/bin/check-gpu.sh \
    && chmod +x /usr/local/bin/check-gpu.sh

# Create a wrapper script for handling Slurm environment variables
RUN echo '#!/bin/bash\necho "Running with Slurm job ID: $SLURM_JOB_ID"\necho "Running on node: $SLURM_NODELIST"\necho "Running with GPU index: $SLURM_IDX"\necho "Checking GPU:"\n/usr/local/bin/check-gpu.sh\nexec "$@"' > /usr/local/bin/slurm-wrapper.sh \
    && chmod +x /usr/local/bin/slurm-wrapper.sh

# Set ownership of all files to the correct user
RUN chown -R coder:usergroup /home/coder

# Finally switch to coder user
USER coder
VOLUME /home/coder/autogoal

CMD ["/bin/bash"]